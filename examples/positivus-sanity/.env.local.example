# Copy to .env.local and fill in from your Sanity project (npx sanity@latest init)
NEXT_PUBLIC_SANITY_PROJECT_ID="your_project_id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Only needed for the seed script (Sanity dashboard → API → Tokens, Editor role).
# Not required at runtime for the public read-only site.
SANITY_API_TOKEN="your_write_token"
